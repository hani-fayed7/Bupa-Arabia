# Copy this file to `.env` and fill in the values.
# `.env` is gitignored: never commit real credentials.

# Site root incl. language. Keep the trailing slash (see tests/utils/env.ts).
BASE_URL=https://careers.bupa.com.sa/en/

# Test account (a candidate account with a CV already uploaded)
USER_EMAIL=
USER_PASSWORD=

# What the apply test does:
#   apply-withdraw = apply, verify, then withdraw (default, leaves the account clean)
#   dry-run        = open the apply modal but do not submit
#   apply          = apply and verify, keep the application
APPLY_MODE=apply-withdraw

# Maximum submission attempts. A job that ends in a CV mismatch, a screening questionnaire
# or a blocking message is skipped, and counts as one attempt.
MAX_JOB_ATTEMPTS=5

# Browsers to run, comma-separated: chromium, firefox, webkit (default: chromium).
# Each browser keeps its own saved session, so each one needs its own `npm run auth` login.
BROWSERS=chromium, firefox, webkit

# Delay in ms added to every browser action, to follow a headed run or a demo by eye (0 = off).
SLOW_MO=500
