# Copy this file to `.env` and fill in the values.
# `.env` is gitignored: never commit real credentials.

# Site root incl. language. Keep the trailing slash (see tests/utils/env.ts).
BASE_URL=https://careers.bupa.com.sa/en/

# Test account (a candidate account with a CV already uploaded)
USER_EMAIL=
USER_PASSWORD=

# How the 4-digit login verification code is obtained.
#   manual = typed in by a person during a headed setup run
OTP_PROVIDER=manual

# What the apply test does:
#   apply-withdraw = apply, verify, then withdraw (default, leaves the account clean)
#   dry-run        = open the apply modal but do not submit
#   apply          = apply and verify, keep the application
APPLY_MODE=apply-withdraw

# Jobs to try before giving up when the "doesn't match requirements" warning appears
MAX_JOB_ATTEMPTS=5
